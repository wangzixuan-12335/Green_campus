# ═══════════════════════════════════════════════
# 绿动校园 · 环境变量配置模板
# 复制此文件为 .env 并修改对应值
# ═══════════════════════════════════════════════

# ─── Django 核心 ───
# 密钥（生产环境必须修改！可用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 生成）
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# 调试模式（生产环境设为 False）
DJANGO_DEBUG=False

# 允许访问的主机名/IP，逗号分隔（如 green.example.com,192.168.1.100）
DJANGO_ALLOWED_HOSTS=*

# ─── 数据库 ───
# 引擎：sqlite 或 mysql
DB_ENGINE=sqlite

# MySQL 配置（DB_ENGINE=mysql 时使用）
DB_NAME=green_campus
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── CORS 跨域 ───
# 前端域名，逗号分隔（如 https://green.example.com,http://localhost）
CORS_ALLOWED_ORIGINS=

# ─── HTTPS（可选）───
SECURE_SSL_REDIRECT=False

# ─── 部署路径（deploy.sh 会读取）───
# 项目部署目录
DEPLOY_DIR=/opt/green-campus
# Gunicorn 监听地址
GUNICORN_BIND=127.0.0.1:8000
# Gunicorn 工作进程数
GUNICORN_WORKERS=3
# 运行用户
DEPLOY_USER=www-data

# ─── 首次部署可选（deploy.sh 读取，不写入 .env）───
# 自动创建超级管理员（仅当库中无超管时生效）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ChangeMeStrong123
# 强制初始化演示数据（首次部署库为空时已自动初始化，无需设置）
# INIT_DEMO_DATA=1
